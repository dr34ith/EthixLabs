@@ -0,0 +1,392 @@
+import 'package:flutter/material.dart';
+import 'package:google_fonts/google_fonts.dart';
+import 'package:provider/provider.dart';
+import 'package:ethixlabs/providers/app_provider.dart';
+import 'package:ethixlabs/theme.dart';
+import 'package:ethixlabs/missions/data/missions_data.dart';
+import 'package:ethixlabs/missions/stages/identify_stage.dart';
+import 'package:ethixlabs/services/simulation_engine.dart';
+import 'stage_scaffold.dart';
+
+// The Test stage embeds the VulnShop simulation with always-visible step guidance.
+class TestStage extends StatefulWidget {
+  final MissionData mission;
+  const TestStage({Key? key, required this.mission}) : super(key: key);
+
+  @override
+  State<TestStage> createState() => _TestStageState();
+}
+
+class _TestStageState extends State<TestStage> {
+  final _payloadController = TextEditingController();
+  SimulationResult? _result;
+  bool _loading = false;
+
+  @override
+  void dispose() {
+    _payloadController.dispose();
+    super.dispose();
+  }
+
+  void _submitPayload() async {
+    final payload = _payloadController.text.trim();
+    setState(() { _loading = true; _result = null; });
+    await Future.delayed(const Duration(milliseconds: 600));
+    final result = SimulationEngine.evaluate(
+      missionNumber: widget.mission.number,
+      payload: payload,
+    );
+    setState(() { _result = result; _loading = false; });
+
+    if (result.success) {
+      final provider = context.read<AppProvider>();
+      final progress = provider.getMissionProgress(widget.mission.number);
+      if (!progress.completedStages.contains(MissionStage.test)) {
+        provider.completeStage(widget.mission.number, MissionStage.test);
+      }
+      _showSuccessDialog(result);
+    }
+  }
+
+  void _showSuccessDialog(SimulationResult result) {
+    showDialog(
+      context: context,
+      barrierDismissible: false,
+      builder: (ctx) => Dialog(
+        backgroundColor: const Color(0xFF1E0A12),
+        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
+        child: Padding(
+          padding: const EdgeInsets.all(24),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              const Icon(Icons.star, color: Colors.amber, size: 52),
+              const SizedBox(height: 12),
+              Text('TEST STAGE COMPLETE!', style: GoogleFonts.orbitron(color: Colors.white, fontSize: 16, fontWeight: FontWeight.bold)),
+              const SizedBox(height: 6),
+              Text('+1 ⭐ Star earned!', style: GoogleFonts.orbitron(color: Colors.amber, fontSize: 14)),
+              const SizedBox(height: 16),
+              if (result.flagValue != null)
+                Container(
+                  padding: const EdgeInsets.all(12),
+                  decoration: BoxDecoration(
+                    color: Colors.green.withOpacity(0.1),
+                    borderRadius: BorderRadius.circular(10),
+                    border: Border.all(color: Colors.green.withOpacity(0.5)),
+                  ),
+                  child: Column(
+                    children: [
+                      Text('🏴 FLAG CAPTURED', style: GoogleFonts.robotoMono(color: Colors.green, fontSize: 12, fontWeight: FontWeight.bold)),
+                      const SizedBox(height: 6),
+                      Text(result.flagValue!, style: GoogleFonts.robotoMono(color: const Color(0xFF7FFF7F), fontSize: 12)),
+                    ],
+                  ),
+                ),
+              const SizedBox(height: 20),
+              SizedBox(
+                width: double.infinity,
+                child: ElevatedButton(
+                  onPressed: () {
+                    Navigator.pop(ctx);
+                    Navigator.push(context, MaterialPageRoute(builder: (_) => IdentifyStage(mission: widget.mission)));
+                  },
+                  style: ElevatedButton.styleFrom(
+                    backgroundColor: AppColors.accent,
+                    foregroundColor: Colors.white,
+                    padding: const EdgeInsets.symmetric(vertical: 14),
+                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(30)),
+                  ),
+                  child: Text('PROCEED TO IDENTIFY', style: GoogleFonts.orbitron(fontSize: 12, fontWeight: FontWeight.bold)),
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final progress = context.watch<AppProvider>().getMissionProgress(widget.mission.number);
+    final alreadyDone = progress.completedStages.contains(MissionStage.test);
+
+    return StageScaffold(
+      stageNumber: 3,
+      stageTitle: 'Test',
+      missionNumber: widget.mission.number,
+      iconPath: 'assets/pixel_images/test.png',
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          // ── Always-Visible Step-by-Step Guidance ──
+          _buildGuidanceCard(),
+          const SizedBox(height: 20),
+
+          // ── VulnShop Simulation Panel ──
+          _buildVulnShopPanel(),
+          const SizedBox(height: 20),
+
+          // ── Payload Input ──
+          _buildPayloadInput(alreadyDone),
+          const SizedBox(height: 12),
+
+          // ── Result Feedback ──
+          if (_loading)
+            const Center(child: Padding(
+              padding: EdgeInsets.all(16),
+              child: CircularProgressIndicator(color: Color(0xFFE68C8C)),
+            )),
+          if (_result != null) _buildResultCard(_result!),
+
+          const SizedBox(height: 20),
+          if (alreadyDone) _buildSkipButton(context),
+          const SizedBox(height: 24),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildGuidanceCard() {
+    final steps = _getGuidanceSteps(widget.mission.number);
+    return Container(
+      padding: const EdgeInsets.all(16),
+      decoration: BoxDecoration(
+        color: const Color(0xFF0A1A0A),
+        borderRadius: BorderRadius.circular(14),
+        border: Border.all(color: Colors.green.withOpacity(0.4)),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Row(
+            children: [
+              const Icon(Icons.menu_book, color: Colors.green, size: 18),
+              const SizedBox(width: 8),
+              Text('Step-by-Step Guidance', style: GoogleFonts.orbitron(color: Colors.green, fontSize: 12, fontWeight: FontWeight.bold)),
+            ],
+          ),
+          const SizedBox(height: 12),
+          ...steps.asMap().entries.map((e) => Padding(
+            padding: const EdgeInsets.only(bottom: 8),
+            child: Row(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Container(
+                  width: 22,
+                  height: 22,
+                  decoration: BoxDecoration(
+                    color: Colors.green.withOpacity(0.2),
+                    shape: BoxShape.circle,
+                    border: Border.all(color: Colors.green.withOpacity(0.5)),
+                  ),
+                  child: Center(child: Text('${e.key + 1}', style: const TextStyle(color: Colors.green, fontSize: 11, fontWeight: FontWeight.bold))),
+                ),
+                const SizedBox(width: 10),
+                Expanded(child: Text(e.value, style: GoogleFonts.robotoMono(color: Colors.white70, fontSize: 12, height: 1.4))),
+              ],
+            ),
+          )),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildVulnShopPanel() {
+    return Container(
+      decoration: BoxDecoration(
+        color: const Color(0xFFF5EDD8),
+        borderRadius: BorderRadius.circular(14),
+        boxShadow: [BoxShadow(color: Colors.black.withOpacity(0.3), blurRadius: 10)],
+      ),
+      child: Column(
+        children: [
+          // VulnShop header
+          Container(
+            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
+            decoration: const BoxDecoration(
+              color: Color(0xFFE68C8C),
+              borderRadius: BorderRadius.only(topLeft: Radius.circular(14), topRight: Radius.circular(14)),
+            ),
+            child: Row(
+              children: [
+                Image.asset('assets/icons/vulnShop.png', height: 28,
+                    errorBuilder: (c, e, s) => const Icon(Icons.shopping_cart, color: Colors.white, size: 24)),
+                const SizedBox(width: 10),
+                const Text('VulnShop', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 16)),
+              ],
+            ),
+          ),
+          // Target description
+          Padding(
+            padding: const EdgeInsets.all(16),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(
+                  widget.mission.testPrompt,
+                  style: const TextStyle(color: Color(0xFF4A3028), fontSize: 13, height: 1.5),
+                ),
+              ],
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildPayloadInput(bool alreadyDone) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Text(widget.mission.testFieldLabel,
+            style: GoogleFonts.robotoMono(color: AppColors.accent, fontSize: 12, fontWeight: FontWeight.bold)),
+        const SizedBox(height: 8),
+        Row(
+          children: [
+            Expanded(
+              child: TextField(
+                controller: _payloadController,
+                style: GoogleFonts.robotoMono(color: const Color(0xFF7FFF7F), fontSize: 13),
+                decoration: InputDecoration(
+                  hintText: 'Enter payload...',
+                  hintStyle: const TextStyle(color: Colors.white24),
+                  filled: true,
+                  fillColor: const Color(0xFF0A1A0A),
+                  border: OutlineInputBorder(
+                    borderRadius: BorderRadius.circular(10),
+                    borderSide: BorderSide(color: AppColors.accent.withOpacity(0.4)),
+                  ),
+                  enabledBorder: OutlineInputBorder(
+                    borderRadius: BorderRadius.circular(10),
+                    borderSide: BorderSide(color: AppColors.accent.withOpacity(0.4)),
+                  ),
+                  focusedBorder: OutlineInputBorder(
+                    borderRadius: BorderRadius.circular(10),
+                    borderSide: BorderSide(color: AppColors.accent, width: 1.5),
+                  ),
+                  contentPadding: const EdgeInsets.symmetric(horizontal: 14, vertical: 14),
+                ),
+                maxLines: 3,
+                minLines: 1,
+              ),
+            ),
+            const SizedBox(width: 10),
+            ElevatedButton(
+              onPressed: _loading ? null : _submitPayload,
+              style: ElevatedButton.styleFrom(
+                backgroundColor: AppColors.accent,
+                foregroundColor: Colors.white,
+                padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 18),
+                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
+              ),
+              child: _loading
+                  ? const SizedBox(width: 20, height: 20, child: CircularProgressIndicator(color: Colors.white, strokeWidth: 2))
+                  : const Icon(Icons.send, size: 20),
+            ),
+          ],
+        ),
+      ],
+    );
+  }
+
+  Widget _buildResultCard(SimulationResult result) {
+    return Container(
+      padding: const EdgeInsets.all(14),
+      decoration: BoxDecoration(
+        color: result.success ? Colors.green.withOpacity(0.1) : Colors.red.withOpacity(0.1),
+        borderRadius: BorderRadius.circular(12),
+        border: Border.all(
+          color: result.success ? Colors.green.withOpacity(0.5) : Colors.red.withOpacity(0.4),
+        ),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Row(
+            children: [
+              Icon(result.success ? Icons.check_circle : Icons.error, color: result.success ? Colors.green : Colors.red, size: 18),
+              const SizedBox(width: 8),
+              Text(result.success ? 'PAYLOAD ACCEPTED' : 'PAYLOAD REJECTED',
+                  style: GoogleFonts.robotoMono(
+                    color: result.success ? Colors.green : Colors.red,
+                    fontSize: 12, fontWeight: FontWeight.bold,
+                  )),
+            ],
+          ),
+          const SizedBox(height: 8),
+          Text(result.message, style: GoogleFonts.robotoMono(color: Colors.white70, fontSize: 12, height: 1.5)),
+          if (result.flagValue != null) ...[
+            const SizedBox(height: 8),
+            Text('🏴 ${result.flagValue}',
+                style: GoogleFonts.robotoMono(color: const Color(0xFF7FFF7F), fontSize: 12, fontWeight: FontWeight.bold)),
+          ],
+        ],
+      ),
+    );
+  }
+
+  Widget _buildSkipButton(BuildContext context) {
+    return SizedBox(
+      width: double.infinity,
+      child: ElevatedButton.icon(
+        onPressed: () => Navigator.push(context, MaterialPageRoute(builder: (_) => IdentifyStage(mission: widget.mission))),
+        icon: const Icon(Icons.arrow_forward, size: 18),
+        label: Text('PROCEED TO IDENTIFY', style: GoogleFonts.orbitron(fontSize: 12, fontWeight: FontWeight.bold)),
+        style: ElevatedButton.styleFrom(
+          backgroundColor: AppColors.accent,
+          foregroundColor: Colors.white,
+          padding: const EdgeInsets.symmetric(vertical: 16),
+          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(30)),
+        ),
+      ),
+    );
+  }
+
+  List<String> _getGuidanceSteps(int missionNumber) {
+    // Always-visible static guidance for each mission type
+    switch (missionNumber) {
+      case 10:
+      case 1:
+        return [
+          'Navigate to the VulnShop login page at /login',
+          'Enter a tautology payload in the username field: try \' OR \'1\'=\'1',
+          'Enter any value in the password field',
+          'Submit the form and observe the response',
+          'If login succeeds, you\'ve bypassed authentication with SQL injection',
+        ];
+      case 11:
+        return [
+          'Navigate to the product search: /products?category=electronics',
+          'Test for SQL injection: add a single quote to the category value',
+          'Determine the number of columns using ORDER BY: try ORDER BY 1, 2, 3...',
+          'Use UNION SELECT to append your query: electronics\' UNION SELECT username,password,email FROM users--',
+          'The response should include user credentials alongside product data',
+        ];
+      case 13:
+        return [
+          'Navigate to a product page and find the product review form',
+          'Submit a test review with plain text to confirm it appears on the page',
+          'Try a simple HTML injection: <b>test</b> — does bold text appear?',
+          'If HTML is rendered, try a XSS payload: <script>alert(\'XSS\')</script>',
+          'Refresh the page — if the alert fires, the payload is stored and affects all visitors',
+        ];
+      case 5:
+        return [
+          'Log in to VulnShop and navigate to your order history',
+          'Note your current order ID in the URL (e.g., /orders?order_id=42)',
+          'Change the order_id parameter to a different integer (e.g., 41, 43)',
+          'Submit the modified URL and observe whether you can see another user\'s order',
+          'Record the exposed data: name, address, items, and payment method',
+        ];
+      default:
+        return [
+          'Read the test prompt carefully above',
+          'Examine VulnShop for the targeted vulnerability',
+          'Craft your payload based on the mission guidance',
+          'Enter your payload in the field below',
+          'Submit and analyze the server\'s response',
+        ];
+    }
+  }
+}
